# ============================================================
#  Business Stack — variables de la instancia de un cliente
#
#  Casi nada se configura aquí. Las cuentas (WhatsApp, Instagram,
#  Facebook, YouTube), las claves y la identidad legal se conectan
#  DESDE EL PANEL, en /admin, y se guardan cifradas en Postgres.
#
#  En Railway estas variables se ponen en Settings -> Variables del
#  servicio de la aplicacion. Este fichero es la referencia, y sirve
#  tambien para levantar la app en local (copialo a .env).
#
#  Paso a paso del alta completa: DESPLIEGUE.md
# ============================================================

# ------------------------------------------------------------
#  OBLIGATORIAS. Sin las tres, la instancia no sirve.
# ------------------------------------------------------------

# Cadena de Postgres. En Railway es una REFERENCIA al complemento,
# no un valor pegado a mano:  ${{Postgres.DATABASE_URL}}
# Anadir el complemento Postgres NO la inyecta solo: hay que crear
# la variable en el servicio de la aplicacion.
# Si falta, la app arranca igual, /health responde {"ok":true} y
# Railway da el despliegue por bueno... pero nada se guarda: cada
# reinicio borra cuentas, contactos y conversaciones.
DATABASE_URL=

# Clave maestra que cifra los secretos en la base de datos, y mitad
# de la semilla que firma las sesiones del panel. Cadena aleatoria
# larga (32+ caracteres), DISTINTA para cada cliente.
# Sin ella el proceso muere al arrancar en produccion.
# No la cambies despues del primer arranque: los secretos ya
# cifrados quedan ilegibles y hay que reconectarlo todo.
APP_ENC_KEY=

# Contrasena del administrador del sistema (el operador).
# Sin ella el panel arranca mostrando "Panel desactivado" y no entra
# nadie: crear usuarios en la base de datos no es una salida, la
# puerta se comprueba antes que la sesion.
ADMIN_PASSWORD=

# ------------------------------------------------------------
#  MUY RECOMENDADAS
# ------------------------------------------------------------

# Firma el 'state' de los inicios de sesion con Meta. Cadena
# aleatoria, distinta por cliente. Sin ella se usa un literal
# publico compartido por todos los despliegues, y el arranque
# lo avisa por consola.
STATE_SECRET=

# Usuario del administrador del sistema. Por defecto: admin
# ADMIN_USER=admin

# Dominio propio del cliente, si lo tiene. Manda sobre el dominio
# que asigna Railway. Tiene que ser https y SIN barra final.
# De aqui salen los enlaces cortos y, sobre todo, la direccion que
# se le da a Meta como destino de los webhooks de cada numero.
# PUBLIC_BASE_URL=https://panel.sudominio.com

# Solo si conectas a un Postgres externo por SSL.
# DATABASE_SSL=require

# ------------------------------------------------------------
#  El puente con systeme.io (segundo servicio)
# ------------------------------------------------------------
# Publicar paginas en systeme.io y leer sus embudos no lo hace esta
# aplicacion: lo hace `systemeio-mcp`, que es un SERVICIO APARTE con
# su propio despliegue. Cada cliente tiene EL SUYO, en su mismo
# proyecto de Railway.
#
# Aqui va la direccion que genera ESE despliegue, no la de nadie mas:
# el puente le manda el correo y la contrasena de systeme.io del
# cliente para abrir sesion.
#
# En Railway, en vez de pegar la URL a mano, usa una referencia al
# otro servicio para que no se quede rancia si cambia el dominio:
#   MCP_URL=https://${{systemeio-mcp.RAILWAY_PUBLIC_DOMAIN}}/mcp
#
# MCP_TOKEN es el INTERNAL_API_SECRET de ese servicio: el mismo valor
# a los dos lados. Tambien vale la referencia:
#   MCP_TOKEN=${{systemeio-mcp.INTERNAL_API_SECRET}}
#
# Sin estas dos, la aplicacion arranca igual y todo lo demas funciona;
# lo unico que queda apagado es publicar paginas y leer embudos, y el
# panel lo dice en Conexiones en vez de fallar sin explicacion.
# MCP_URL=
# MCP_TOKEN=
# Cabecera de autenticacion. El valor por defecto ya es el que pide
# systemeio-mcp; solo se toca si ese servicio cambia de contrato.
# MCP_AUTH_HEADER=X-Internal-Secret

# ------------------------------------------------------------
#  Railway las pone sola: no las escribas
# ------------------------------------------------------------
#   PORT                    puerto de escucha
#   RAILWAY_PUBLIC_DOMAIN   dominio publico de la instancia
#   NODE_ENV                el Dockerfile lo fija a production

# ============================================================
#  LISTA NEGRA
#
#  Estas NO se ponen NUNCA en el Railway de un cliente. No dan
#  error: rompen en silencio, y en el panel de Meta todo sigue
#  saliendo en verde.
#
#  WHATSAPP_PHONE_NUMBER_ID   Todos los espacios de trabajo
#  IG_BUSINESS_ACCOUNT_ID     reclaman ese canal como suyo. Con dos
#                             o mas activos el enrutado lo declara
#                             en conflicto y descarta los mensajes
#                             respondiendo 200 a Meta: al panel no
#                             entra nada y no hay ningun error.
#
#  WHATSAPP_ACCESS_TOKEN      Cualquier espacio de trabajo nuevo
#  IG_ACCESS_TOKEN            hereda esas credenciales.
#  META_ADS_TOKEN
#  META_AD_ACCOUNT_ID
#
#  ROUTING_STRICT             Solo la lleva la instancia central del
#                             operador. Aqui descarta con 200 todo
#                             lo que llegue antes de conectar el canal.
#
#  ALLOW_INSECURE_ENC_KEY     Arranca cifrando con una clave de
#                             desarrollo publica. Nunca.
#
#  DEEPINFRA_API_KEY          No activa nada: esa clave no tiene
#                             respaldo por entorno. Se pega en
#                             Conexiones -> Inteligencia Artificial.
#
#  Las cuentas de WhatsApp, Instagram, Facebook, Meta Ads y YouTube
#  se conectan SIEMPRE desde la vista Conexiones del panel.
# ============================================================
